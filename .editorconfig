# ResearchAssistant EditorConfig
# 统一跨编辑器/跨平台的代码格式
# 插件：https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python 后端
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# JavaScript / TypeScript / JSON / YAML
[*.{js,jsx,ts,tsx,json,yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = 100

# Markdown / 文档
[*.{md,mdx}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 120

# Shell / Makefile
[*.{sh,bash}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
