# ResearchAssistant — 环境变量模板
# ------------------------------------------------------------------
# 用法：复制本文件为 .env.local，再填入你自己的 DeepSeek API Key。
#       .env / .env.local 均已被 .gitignore 忽略，绝不会被提交。
#
# 说明：桌面应用运行时的 API Key 主要在应用内「设置」页填写，
#       并以 Fernet 加密存储于本地 SQLite（见 backend/services/secrets.py），
#       无需手动编辑本文件。
#       下列变量供开发期 / 命令行抽取脚本（backend/_*.py）直接读取使用。
# ------------------------------------------------------------------

# 你的 DeepSeek API Key（在 https://platform.deepseek.com 申请；切勿提交真实值）
DEEPSEEK_API_KEY=your-key-here

# DeepSeek API 基址（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型
DEEPSEEK_MODEL=deepseek-v4-flash
