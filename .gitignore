# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ---------- Node.js / Electron ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ---------- Frontend Build ----------
frontend/dist/
frontend/build/
frontend/.cache/
*.tsbuildinfo

# ---------- Electron ----------
electron/dist/
release/
out/
*.dmg
*.exe
*.zip
*.tar.gz
*.AppImage

# ---------- IDE / Editor ----------
.idea/
.vscode/
.codebuddy/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- SQLite / Data ----------
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- Logs / Temp ----------
logs/
*.log
tmp/
temp/
*.tmp

# ---------- Test / Coverage ----------
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# ---------- Security ----------
*.pem
*.key
secrets.json
credentials.json
